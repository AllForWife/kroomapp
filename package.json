{
  "name": "kroom-desktop",
  "productName": "K ROOM",
  "version": "1.0.9-beta.3",
  "description": "K ROOM for Windows and macOS: the website in its own window, without the browser's autoplay gate and background throttling",
  "author": "K ROOM",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:zip": "electron-builder --win zip --x64",
    "release": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --universal",
    "release:mac": "electron-builder --mac --universal --publish never",
    "release:mac:adhoc": "electron-builder --mac --universal --publish never -c.mac.identity=- -c.mac.hardenedRuntime=false -c.extraMetadata.macAdhoc=true"
  },
  "build": {
    "appId": "xyz.548754321.kroom",
    "productName": "K ROOM",
    "publish": [
      {
        "provider": "github",
        "owner": "AllForWife",
        "repo": "kroomapp"
      }
    ],
    "protocols": [
      {
        "name": "K ROOM",
        "schemes": [
          "kroom"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "keyshift.js",
      "offline.html",
      "package.json"
    ],
    "win": {
      "icon": "icon.png",
      "artifactName": "KRoom-win-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "KRoom-Setup.${ext}"
    },
    "mac": {
      "icon": "icon.png",
      "category": "public.app-category.music",
      "artifactName": "KRoom-mac.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "K ROOM 用麥克風讓你在包廂裡唱歌、和朋友說話。"
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "title": "K ROOM"
    }
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.16.1"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
