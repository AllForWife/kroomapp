{
  "name": "kroom-desktop",
  "productName": "K ROOM",
  "version": "1.0.17",
  "description": "K ROOM for Windows and macOS: the website in its own window, without the browser's autoplay gate and background throttling",
  "author": "K ROOM",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "facetrack": "node facetrack.mjs",
    "predist": "npm run facetrack",
    "dist": "electron-builder --win --x64",
    "predist:zip": "npm run facetrack",
    "dist:zip": "electron-builder --win zip --x64",
    "prerelease": "npm run facetrack",
    "release": "electron-builder --win --x64 --publish never",
    "predist:mac": "npm run facetrack",
    "dist:mac": "electron-builder --mac --universal",
    "prerelease:mac": "npm run facetrack",
    "release:mac": "electron-builder --mac --universal --publish never",
    "prerelease:mac:adhoc": "npm run facetrack",
    "release:mac:adhoc": "electron-builder --mac --universal --publish never -c.mac.identity=- -c.mac.hardenedRuntime=false -c.extraMetadata.macAdhoc=true",
    "start:steam": "node steam/start-steam.js",
    "predist:steam": "npm run facetrack",
    "dist:steam": "electron-builder --win --x64 --config steam/electron-builder.steam.json --publish never"
  },
  "build": {
    "appId": "xyz.548754321.kroom",
    "productName": "K ROOM",
    "publish": [
      {
        "provider": "github",
        "owner": "AllForWife",
        "repo": "kroomapp"
      }
    ],
    "protocols": [
      {
        "name": "K ROOM",
        "schemes": [
          "kroom",
          "discord-1569425359034781747"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "keyshift.js",
      "offline.html",
      "buildflags.js",
      "steam-integration.js",
      "discord.js",
      "vmc.js",
      "package.json"
    ],
    "win": {
      "icon": "icon.png",
      "artifactName": "KRoom-win-${arch}.${ext}",
      "extraResources": [{ "from": "facetrack-dist/win", "to": "facetrack", "filter": ["**/*"] }],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "KRoom-Setup.${ext}"
    },
    "mac": {
      "icon": "icon.png",
      "category": "public.app-category.music",
      "artifactName": "KRoom-mac.${ext}",
      "extraResources": [{ "from": "facetrack-dist/mac", "to": "facetrack", "filter": ["**/*"] }],
      "x64ArchFiles": "Contents/Resources/facetrack/**",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "K ROOM 用麥克風讓你在包廂裡唱歌、和朋友說話。",
        "NSCameraUsageDescription": "VTuber 演出時，K ROOM 用攝影機在你的電腦上追蹤臉部表情和動作（影像不會上傳）。"
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "title": "K ROOM"
    }
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.16.1"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
